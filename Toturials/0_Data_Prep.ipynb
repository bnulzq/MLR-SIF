    {
      "cell_type": "code",
      "source": [
        "site_lat = parameter[parameter.Parameter == 'Lat'].Value.values[0]\n",
        "site_lon = parameter[parameter.Parameter == 'Lon'].Value.values[0]\n",
        "site_LAI = lai.sel(lat=site_lat, lon=site_lon, method='nearest').LAI.values\n"
      ],
      "metadata": {
        "id": "0UcEiRt65YjH"
      },
      "execution_count": null,
