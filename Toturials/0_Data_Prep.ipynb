      "source": [
        "# Data prepration"
      ],
      "metadata": {
        "id": "lZWl0VLDTjak"
      }
    },
    {
      "cell_type": "markdown",
      "source": [
        "1. SIF obs -> `SIF_ORNL_3FLD`\n",
        "2. Irradiance -> `Irradiance_ORNL`\n",
        "3. EC & Meteo -> `AMF_US-xRN_FLUXNET_2019-2024_v1.3_r1`\n",
        "4. LAI -> `c_gls_LAI300-RT6_202508100000_GLOBE_OLCI_V2.0.1.nc`\n",
        "5. Parameters -> `Parameter value`"
      ],
      "metadata": {
        "id": "Lf4u2dzmTryF"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "import numpy as np\n",
        "import pandas as pd\n",
        "import xarray as xr\n"
      ],
      "metadata": {
        "id": "wwmdkVrcTmeg"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "4f2d7bc5"
      },
      "source": [
        "# Mount Google Drive to access files\n",
        "from google.colab import drive\n",
        "drive.mount('/content/drive')"
      ],
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "source": [
        "## Input data"
      ],
      "metadata": {
        "id": "m7U-gofvdNSK"
      }
    },
    {
      "cell_type": "markdown",
      "source": [
        "### SIF obs"
      ],
      "metadata": {
        "id": "Bzge_Nb9lNu-"
      }
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "23cd46a9"
      },
      "source": [
        "import os\n",
        "\n",
        "# Define the path to your SIF_ORNL_3FLD folder in Google Drive\n",
        "# IMPORTANT: Adjust this path to match your actual folder location in Google Drive\n",
        "sif_folder_path = '/content/drive/MyDrive/Anna_SIF_Tutorials/SIF_ORNL_3FLD/'\n",
        "\n",
        "# Check if the folder exists\n",
        "if not os.path.exists(sif_folder_path):\n",
        "    print(f\"Error: Folder not found at {sif_folder_path}. Please adjust the 'sif_folder_path' variable.\")\n",
        "else:\n",
        "    # Filter for .xlsx files\n",
        "    sif_files = [os.path.join(sif_folder_path, f) for f in os.listdir(sif_folder_path) if f.endswith('.xlsx')]\n",
        "\n",
        "    if not sif_files:\n",
        "        print(f\"No XLSX files found in {sif_folder_path}. Please check the folder content.\")\n",
        "    else:\n",
        "        # Read and concatenate all SIF XLSX files\n",
        "        sif_obs_df_list = []\n",
        "        for f in sif_files:\n",
        "            try:\n",
        "                df_temp = pd.read_excel(f)\n",
        "                sif_obs_df_list.append(df_temp)\n",
        "            except Exception as e:\n",
        "                print(f\"Error reading {f}: {e}\")\n",
        "\n",
        "        if sif_obs_df_list:\n",
        "            sif_obs_df = pd.concat(sif_obs_df_list, ignore_index=True)\n",
        "            print('SIF_ORNL_3FLD data loaded and concatenated. Displaying first 5 rows:')\n",
        "            display(sif_obs_df.head())\n",
        "        else:\n",
        "            print(\"No SIF dataframes were successfully loaded.\")"
      ],
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "sif_obs_df"
      ],
      "metadata": {
        "id": "jimpOb_Rmuty"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "09bd433d"
      },
      "source": [
        "# Ensure 'veg_timestamp' is datetime\n",
        "sif_obs_df['veg_timestamp'] = pd.to_datetime(sif_obs_df['veg_timestamp'])\n",
        "\n",
        "# Set 'veg_timestamp' as index for resampling\n",
        "sif_obs_df_resampled = sif_obs_df.set_index('veg_timestamp')\n",
        "\n",
        "# Resample to half-hourly and calculate the mean\n",
        "sif_obs_df_half_hourly = sif_obs_df_resampled.resample('30T').mean()\n",
        "sif_obs_df_half_hourly = sif_obs_df_half_hourly['3FLD_uW_m2_nm']\n",
        "print('SIF observations aggregated to half-hourly averages:')\n",
        "display(sif_obs_df_half_hourly.head())"
      ],
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "source": [
        "### Irradiance -> Ref"
      ],
      "metadata": {
        "id": "jXrvGWBPlRXm"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "import os\n",
        "\n",
        "# Define the path to your Irradiance_ORNL folder in Google Drive\n",
        "# IMPORTANT: Adjust this path to match your actual folder location in Google Drive\n",
        "irradiance_folder_path = '/content/drive/MyDrive/Anna_SIF_Tutorials/Irradiance_ORNL/'\n",
        "\n",
        "# Check if the folder exists\n",
        "if not os.path.exists(irradiance_folder_path):\n",
        "    print(f\"Error: Folder not found at {irradiance_folder_path}. Please adjust the 'irradiance_folder_path' variable.\")\n",
        "else:\n",
        "    # Filter for .parquet files within the folder\n",
        "    irradiance_files = [os.path.join(irradiance_folder_path, f) for f in os.listdir(irradiance_folder_path) if f.endswith('.parquet')]\n",
        "\n",
        "    if not irradiance_files:\n",
        "        print(f\"No Parquet files found in {irradiance_folder_path}. Please check the folder content.\")\n",
        "    else:\n",
        "        # Read and concatenate all Irradiance Parquet files\n",
        "        irradiance_df_list = []\n",
        "        for f in irradiance_files:\n",
        "            print(f\"Attempting to read: {f}\") # Debug print\n",
        "            try:\n",
        "                df_temp = pd.read_parquet(f)\n",
        "                irradiance_df_list.append(df_temp)\n",
        "            except Exception as e:\n",
        "                print(f\"Error reading {f}: {e}\") # Explicitly print the error\n",
        "\n",
        "        if irradiance_df_list:\n",
        "            irradiance_df = pd.concat(irradiance_df_list, ignore_index=True)\n",
        "            print('Irradiance_ORNL data loaded and concatenated. Displaying first 5 rows:')\n",
        "            display(irradiance_df.head())\n",
        "        else:\n",
        "            print(\"No Irradiance dataframes were successfully loaded after attempting all files.\")"
      ],
      "metadata": {
        "id": "qtzOBYpDU7Je"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "irradiance_df.columns"
      ],
      "metadata": {
        "id": "35UsU6Rsjz_r"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "red_band_columns = []\n",
        "nir_band_columns_to_sum = ['805.75', '805.89', '806.02']\n",
        "\n",
        "for col in irradiance_df.columns:\n",
        "    try:\n",
        "        wavelength = float(col)\n",
        "        # Identify columns for the 'Red' band (620-670 nm)\n",
        "        if 620 <= wavelength <= 670:\n",
        "            red_band_columns.append(col)\n",
        "    except ValueError:\n",
        "        pass\n",
        "\n",
        "# Create the new DataFrame with desired columns and aggregations\n",
        "irradiance_df_1 = pd.DataFrame({\n",
        "    'TIMESTAMP': irradiance_df['TIMESTAMP'],\n",
        "    'MotorFiberFace_Trk': irradiance_df['MotorFiberFace_Trk'],\n",
        "    'Red': irradiance_df[red_band_columns].sum(axis=1),\n",
        "    'SIF': irradiance_df['760.48'], # Rename '760.48' to 'SIF'\n",
        "    'NIR': irradiance_df[nir_band_columns_to_sum].sum(axis=1)\n",
        "})\n",
        "\n",
        "display(irradiance_df_1.head())"
      ],
      "metadata": {
        "id": "HLNtKPkpepQo"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "76d2eac8"
      },
      "source": [
        "## Calculate Reflectance"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "a95472d0"
      },
      "source": [
        "# Separate 'veg' and 'sky' measurements\n",
        "irradiance_veg = irradiance_df_1[irradiance_df_1['MotorFiberFace_Trk'] == 'veg'].reset_index(drop=True)\n",
        "irradiance_sky = irradiance_df_1[irradiance_df_1['MotorFiberFace_Trk'] == 'sky'].reset_index(drop=True)\n",
        "\n",
        "# Ensure both DataFrames have the same number of rows for division\n",
        "min_rows = min(len(irradiance_veg), len(irradiance_sky))\n",
        "irradiance_veg = irradiance_veg.iloc[:min_rows]\n",
        "irradiance_sky = irradiance_sky.iloc[:min_rows]\n",
        "\n",
        "# Calculate Reflectance for Red, SIF, and NIR bands\n",
        "reflectance_df = pd.DataFrame({\n",
        "    'TIMESTAMP': irradiance_veg['TIMESTAMP'],\n",
        "    'Reflectance_Red': irradiance_veg['Red'] / irradiance_sky['Red'],\n",
        "    'Reflectance_SIF': irradiance_veg['SIF'] / irradiance_sky['SIF'],\n",
        "    'Reflectance_NIR': irradiance_veg['NIR'] / irradiance_sky['NIR']\n",
        "})\n",
        "\n",
        "print('Reflectance calculated. Displaying first 5 rows:')\n",
        "display(reflectance_df.head())"
      ],
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "3a35bd96"
      },
      "source": [
        "# Ensure 'TIMESTAMP' is datetime in reflectance_df\n",
        "reflectance_df['TIMESTAMP'] = pd.to_datetime(reflectance_df['TIMESTAMP'])\n",
        "\n",
        "# Set 'TIMESTAMP' as index for resampling\n",
        "reflectance_df_resampled = reflectance_df.set_index('TIMESTAMP')\n",
        "\n",
        "# Resample to half-hourly and calculate the mean\n",
        "reflectance_df_half_hourly = reflectance_df_resampled.resample('30min').mean()\n",
        "\n",
        "print('Reflectance data aggregated to half-hourly averages:')\n",
        "display(reflectance_df_half_hourly.head())"
      ],
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "66dbe0c2"
      },
      "source": [
        "## Combine SIF and Reflectance Data\n"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "1c517f4d"
      },
      "source": [
        "# Combine reflectance_df_half_hourly and sif_obs_df_half_hourly\n",
        "# Both dataframes should have 'TIMESTAMP' as their index already.\n",
        "combined_sif_reflectance_df = pd.merge(\n",
        "    reflectance_df_half_hourly,\n",
        "    sif_obs_df_half_hourly,\n",
        "    left_index=True,\n",
        "    right_index=True,\n",
        "    how='outer'\n",
        ")\n",
        "\n",
        "print('Combined SIF and Reflectance data. Displaying first 5 rows:')\n",
        "display(combined_sif_reflectance_df.head())"
      ],
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "source": [
        "## Input EC&Meteo data"
      ],
      "metadata": {
        "id": "aYgjO2kbzXqY"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "import os\n",
        "\n",
        "# Define the path to your EC & Meteo folder in Google Drive\n",
        "# IMPORTANT: Adjust this path to match your actual folder location in Google Drive\n",
        "ec_meteo_folder_path = '/content/drive/MyDrive/Anna_SIF_Tutorials/AMF_US-xRN_FLUXNET_2019-2024_v1.3_r1/'\n",
        "\n",
        "# Define the specific EC & Meteo CSV file\n",
        "ec_meteo_file_name = 'AMF_US-xRN_FLUXNET_FLUXMET_HH_2019-2024_v1.3_r1.csv'\n",
        "ec_meteo_file_path = os.path.join(ec_meteo_folder_path, ec_meteo_file_name)\n",
        "\n",
        "# Check if the file exists\n",
        "if not os.path.exists(ec_meteo_file_path):\n",
        "    print(f\"Error: Specific EC & Meteo file not found at {ec_meteo_file_path}. Please check the path and file name.\")\n",
        "else:\n",
        "    print(f\"Attempting to read: {ec_meteo_file_path}\")\n",
        "    try:\n",
        "        ec_meteo_df = pd.read_csv(ec_meteo_file_path)\n",
        "        print('EC & Meteo data loaded. Displaying first 5 rows:')\n",
        "        display(ec_meteo_df.head())\n",
        "    except Exception as e:\n",
        "        print(f\"Error reading {ec_meteo_file_path}: {e}\")"
      ],
      "metadata": {
        "id": "N_N_Og9YdFKq"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "ec_meteo_df"
      ],
      "metadata": {
        "id": "7jZJJCBTqW02"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "ec_meteo_df = ec_meteo_df[['PPFD_IN', 'TA_F', 'VPD_F', 'PA_F', 'CO2_F_MDS', 'TIMESTAMP_START', 'GPP_NT_VUT_REF',]]"
      ],
      "metadata": {
        "id": "XYpx3KLYd0-9"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "7ef38265"
      },
      "source": [
        "# Define the path to your 'codes_MLR' folder in Google Drive\n",
        "# IMPORTANT: Adjust this path to match your actual folder location if different\n",
        "codes_mlr_folder_path = '/content/drive/MyDrive/Anna_SIF_Tutorials/codes_MLR/'\n",
        "\n",
        "# Define the parameter file name, assuming it's now a CSV\n",
        "parameter_file_name = 'Parameter.xlsx'\n",
        "\n",
        "parameter = pd.read_excel(os.path.join(codes_mlr_folder_path, parameter_file_name))\n",
        "parameter\n",
        "\n"
      ],
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "source": [
        "### Convert the time for EC & Meterological\n",
        "\n"
      ],
      "metadata": {
        "id": "diTA06PrxOLV"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "parameter"
      ],
      "metadata": {
        "id": "76OxI_cLx3Yx"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "tz = parameter[parameter.Parameter == 'TZ'].Value\n",
        "tz"
      ],
      "metadata": {
        "id": "UYzrkuEPxYAR"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "tz = parameter[parameter.Parameter == 'TZ'].Value\n",
        "ec_meteo_df['Time'] = pd.to_datetime(ec_meteo_df['TIMESTAMP_START'], format = '%Y%m%d%H%M')- pd.Timedelta(hours=int(tz))\n",
        "ec_meteo_df['Time_2025'] = ec_meteo_df['Time'] + pd.Timedelta(days=365)\n",
        "ec_meteo_df.index = ec_meteo_df.Time_2025"
      ],
      "metadata": {
        "id": "9G1b7epNtZBl"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "ec_meteo_df"
      ],
      "metadata": {
        "id": "YGzJzuNNz6bG"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "\n",
        "# Combine reflectance_df_half_hourly and sif_obs_df_half_hourly\n",
        "# Both dataframes should have 'TIMESTAMP' as their index already.\n",
        "combined_sif_reflectance_EC_df = pd.merge(\n",
        "    combined_sif_reflectance_df,\n",
        "    ec_meteo_df,\n",
        "    left_index=True,\n",
        "    right_index=True,\n",
        "    how='left'\n",
        ")\n",
        "\n",
        "print('Combined SIF and EC data. Displaying first 5 rows:')\n",
        "display(combined_sif_reflectance_EC_df.head())"
      ],
      "metadata": {
        "id": "taJZazyAxtKN"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "source": [
