    },
    {
      "cell_type": "code",
      "source": [
        "lai_file_path = '/content/drive/MyDrive/Anna_SIF_Tutorials/c_gls_LAI300-RT6_202508100000_GLOBE_OLCI_V2.0.1.nc'\n",
        "lai = xr.open_dataset(lai_file_path)\n",
        "lai\n"
      ],
      "metadata": {
